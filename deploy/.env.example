# Public URL of the backend (used in emails)
BASE_URL=https://zweier.example.com

POSTGRES_USER=zweier
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zweier

# openssl rand -hex 32
SECRETS_AES_KEY=
# openssl rand -hex 16
SECRETS_AES_IV=
# session tokens are HS256: put the SAME long random secret in both (openssl rand -hex 48)
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Download link in partner invitation mails (default: latest GitHub release)
# APP_DOWNLOAD_URL=https://github.com/wertania/zweier-app/releases/latest

# App update hint: the newest version is read from the latest GitHub release.
# APP_LATEST_VERSION=1.4.0   # optional: fix the version instead
# APP_MIN_VERSION=1.2.0      # optional: older apps must update before they can continue

# Login codes are sent by email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_DEFAULT_SENDER=zweier@example.com
