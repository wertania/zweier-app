{
  "name": "app-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/bun": "^1.4.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.66",
    "@ai-sdk/openai-compatible": "~3.0.71",
    "@ai-sdk/valibot": "^3.0.62",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "0.6.1",
    "@hono/valibot-validator": "0.6.1",
    "@mozilla/readability": "^0.6.0",
    "@simplewebauthn/server": "^14.0.3",
    "@valibot/to-json-schema": "^1.8.0",
    "ai": "^7.0.143",
    "cron": "4.4.0",
    "csv": "6.6.4",
    "drizzle-orm": "0.45.4",
    "drizzle-valibot": "0.4.2",
    "hono": "4.13.13",
    "hono-openapi": "1.3.5",
    "jsonwebtoken": "9.0.3",
    "linkedom": "^0.18.13",
    "nanoid": "6.0.2",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "pgvector": "0.3.0",
    "postgres": "3.4.9",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "valibot": "^1.5.0"
  },
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:remove": "docker compose down -v",
    "dev": "bun --hot run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify",
    "typecheck": "tsc --noEmit",
    "test:local": "bun run ./framework/.scripts/test-local.ts",
    "db:local": "bun run ./framework/.scripts/local-db-server.ts",
    "db:query": "bun run ./framework/.scripts/db-query.ts",
    "clean": "rm -rf ./lib/",
    "app:migrate": "drizzle-kit migrate",
    "app:generate": "drizzle-kit generate",
    "app:studio": "drizzle-kit studio",
    "framework:migrate": "drizzle-kit migrate --config framework/drizzle.config.ts",
    "framework:generate": "drizzle-kit generate --config framework/drizzle.config.ts",
    "generate": "drizzle-kit generate --config framework/drizzle.config.ts && drizzle-kit generate",
    "migrate": "drizzle-kit migrate --config framework/drizzle.config.ts && drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "release:patch": "tsc && npm version patch && git push --follow-tags && npm publish",
    "release:minor": "tsc && npm version minor && git push --follow-tags && npm publish",
    "release:major": "tsc && npm version major && git push --follow-tags && npm publish",
    "sync-skills": "bun run ./framework/.scripts/sync-skills.ts",
    "sync-deps": "bun run ./framework/.scripts/update-dependencies.ts",
    "init": "bun run ./framework/.scripts/init.ts",
    "add-demo-data": "bun run seeds/run.ts demo"
  }
}
